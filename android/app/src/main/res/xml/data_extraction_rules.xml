<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (targetSdk 31+): what cloud backup and device-to-device transfer
  may take. Nothing. `allowBackup="false"` no longer stops a device transfer
  from Android 12, and `fullBackupContent` is ignored there (UAT review C7).

  The cached session, the install marker and the keystore-backed preferences
  belong to this installation: carried to a new phone they would defeat the
  fresh-install check in InstallIdentity (CORE-02) and move an HR session
  between handsets (PROF-01).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
